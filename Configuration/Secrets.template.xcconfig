// Terigo public client ID. Replace this only when using your own Strava app.
STRAVA_CLIENT_ID = 168528
// Prefer the auth broker below. Release builds always strip this field.
STRAVA_CLIENT_SECRET =
STRAVA_REDIRECT_URI = routevault:/$()/localhost/oauth-callback
STRAVA_CALLBACK_SCHEME = routevault
STRAVA_ACCESS_TOKEN =
STRAVA_REFRESH_TOKEN =
STRAVA_SCOPE =
STRAVA_ACCESS_TOKEN_EXPIRES_AT =
// Optional public Mapbox token; Apple Maps is used when empty.
MAPBOX_PUBLIC_TOKEN =
// Optional accounts and sharing backend. Use your live project URL.
ROUTE_VAULT_SUPABASE_URL =
ROUTE_VAULT_SUPABASE_PUBLISHABLE_KEY =
ROUTE_VAULT_FUNCTIONS_BASE_URL =
// Required for OAuth without an embedded development secret.
// Example: https:/$()/PROJECT.supabase.co/functions/v1/strava-auth-broker
ROUTE_VAULT_STRAVA_AUTH_BROKER_URL =
ROUTE_VAULT_SHARE_BASE_URL =
ROUTE_VAULT_SHARE_LINK_HOST =
